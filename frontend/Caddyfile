{
	auto_https off
	admin off
	persist_config off
	servers {
		# Nur vorgeschaltete Proxys im privaten Netz dürfen die Client-IP über X-Forwarded-For setzen
		trusted_proxies static {$TRUSTED_PROXIES:private_ranges}
	}
}

# TLS endet am vorgeschalteten Reverse Proxy; dieser Container spricht HTTP im privaten Netz.
:8080 {
	encode zstd gzip

	# Keine fremden Skripte, Schriften oder Stile (Plan 6.7). Einzige fremde Quelle: Kartenkacheln der
	# Géoplateforme (G1), von MapLibre per fetch geladen. Der Karten-Worker kommt aus dem eigenen Build.
	# Nicht für die Planunterlagen der Zitate (AN2, ANNAHMEN PU06): Chrome zeigt ein PDF unter
	# `object-src 'none'` und `style-src 'self'` nicht an (Chromium-Fehler 40328564). Die API liefert dort
	# nur geprüfte PDFs an das Büro, mit `nosniff`.
	@seiten not path /api/v1/regulation-files/*
	header @seiten {
		Content-Security-Policy "default-src 'self'; script-src 'self'; worker-src 'self'; style-src 'self'; img-src 'self' data: blob: https://data.geopf.fr; font-src 'self'; connect-src 'self' https://data.geopf.fr; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
		-Server
	}

	handle /api/* {
		reverse_proxy {$API_UPSTREAM}
	}

	# Ein Image, zwei Produkte (AN0): SPA_INDEX wählt die Einstiegsseite dieses Stacks –
	# index.html (Hauskonfigurator, Standard) oder analyse.html (Emprise Analyse).
	handle {
		root * /srv
		@assets path /assets/*
		@pages not path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header @pages Cache-Control "no-cache"
		try_files {path} /{$SPA_INDEX:index.html}
		file_server {
			# ohne `index` liefert das Wurzelverzeichnis immer index.html, auch im Analyse-Stack
			index {$SPA_INDEX:index.html}
		}
	}
}
