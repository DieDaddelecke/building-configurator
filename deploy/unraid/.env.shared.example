# Gemeinsamer Stack „emprise-shared“ (PLAN_G2_VOLLSTAENDIGKEIT 3.9). Kopieren nach .env.shared und Werte
# setzen; nie ins Repository. Aufruf: ./deploy.sh shared (vor den Produkten).
# Geheimnisse sind eigene (openssl rand -hex 32). APP_DB_PASSWORD und MIGRATOR_DB_PASSWORD tragen beide
# Produkte als SHARED_APP_DB_PASSWORD und SHARED_MIGRATOR_DB_PASSWORD in ihre .env bzw. .env.analyse ein.

APPDATA_DIR=/mnt/user/appdata/emprise-shared
BACKUP_DIR=/mnt/user/backups/emprise-shared
TZ=Europe/Paris

POSTGRES_PASSWORD=
MIGRATOR_DB_PASSWORD=
APP_DB_PASSWORD=
READONLY_DB_PASSWORD=

# Sicherung wie bei den Produkten: täglich um BACKUP_HOUR Uhr, Aufbewahrung in Tagen
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14
