# Kopieren nach .env. Zufallswerte: openssl rand -hex 32
APPDATA_DIR=/mnt/user/appdata/authentik
AUTHENTIK_PORT=9000
TZ=Europe/Paris

# Öffentliche Adresse von Authentik über den Reverse Proxy
AUTHENTIK_BASE_URL=https://auth.aslani.work

AUTHENTIK_SECRET_KEY=
PG_PASS=

# Muss mit PUBLIC_BASE_URL und OIDC_CLIENT_SECRET in deploy/unraid/.env übereinstimmen
EMPRISE_PUBLIC_BASE_URL=https://building-configurator.aslani.work
EMPRISE_OIDC_CLIENT_SECRET=
