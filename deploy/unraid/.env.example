# Kopieren nach .env und Werte setzen. .env nie ins Repository.
# Zufallswerte erzeugen:  openssl rand -hex 32

# Öffentliche Adresse (Reverse Proxy mit TLS)
PUBLIC_BASE_URL=https://building-configurator.aslani.work

# Ablage auf Unraid
APPDATA_DIR=/mnt/user/appdata/emprise
BACKUP_DIR=/mnt/user/backups/emprise
WEB_PORT=8480
TZ=Europe/Paris

# Geheimnisse (je 64 Hex-Zeichen)
SECRET_KEY=
POSTGRES_PASSWORD=
MIGRATOR_DB_PASSWORD=
APP_DB_PASSWORD=
READONLY_DB_PASSWORD=
S3_SECRET_KEY=

# Anmeldung Büro über Authentik (deploy/unraid/authentik)
OIDC_ISSUER=https://auth.aslani.work/application/o/emprise/
OIDC_CLIENT_ID=emprise
OIDC_CLIENT_SECRET=

# Mail (Anbieter offen, E2). Ohne Werte scheitern Mailjobs und werden wiederholt.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=Emprise <no-reply@aslani.work>

# Grundstück (G1): Einzugsgebiet als JSON-Liste von INSEE-Codes (D1, 14.09.2026: bis zur Beta nur Treillières)
CADASTRE_COMMUNES=["44209"]

# Regelwerk (G2): Schlüssel von OpenRouter (openrouter.ai/keys), Monatsbudget in US-Dollar
OPENROUTER_API_KEY=
RULES_BUDGET_MONTH_USD=150

# Sicherung
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14

# Optional: Fehler-Tracking
SENTRY_DSN=
