# Zweiter Stack „Emprise Analyse“ (AN0). Kopieren nach .env.analyse und Werte setzen; nie ins Repository.
# Aufruf:  ./deploy.sh analyse   (entspricht docker compose -f compose.yaml -f compose.analyse.yaml
#                                 --env-file .env.analyse …)
# Geheimnisse hier sind eigene, nicht die des Hauskonfigurators: openssl rand -hex 32

# Eigener Hostname hinter demselben Reverse Proxy
PUBLIC_BASE_URL=https://analyse.aslani.work

# Eigene Ablage und eigener Port; nichts davon teilt sich mit dem Hauskonfigurator
APPDATA_DIR=/mnt/user/appdata/emprise-analyse
BACKUP_DIR=/mnt/user/backups/emprise-analyse
WEB_PORT=8481
TZ=Europe/Paris

# Bild-Kennzeichen dieses Stacks; deploy.sh setzt es beim Ausliefern auf die gebaute Release
EMPRISE_RELEASE=current-analyse

# Geheimnisse (je 64 Hex-Zeichen), eigene Datenbank und eigener Objektspeicher
SECRET_KEY=
POSTGRES_PASSWORD=
MIGRATOR_DB_PASSWORD=
APP_DB_PASSWORD=
READONLY_DB_PASSWORD=
S3_SECRET_KEY=

# Eigene Anwendung in Authentik (eigene Rücksprungadresse, eigene Gruppe)
OIDC_ISSUER=https://auth.aslani.work/application/o/emprise-analyse/
OIDC_CLIENT_ID=emprise-analyse
OIDC_CLIENT_SECRET=

# Mail (Anbieter offen, E2)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=Emprise Analyse <no-reply@aslani.work>

# Kein vorausgedachtes Einzugsgebiet (D17): Parzelle und PLU kommen als Upload. Der Katasterklick
# bleibt möglich, sobald hier eine Gemeinde steht – dann läuft ihr Import von Hand (BETRIEB 8).
CADASTRE_COMMUNES=[]

# Regelwerk (G2): eigener Schlüssel (OpenRouter) und eigenes Budget, damit die Kosten je Produkt sichtbar bleiben
OPENROUTER_API_KEY=
RULES_BUDGET_MONTH_USD=150

# Sicherung
BACKUP_HOUR=4
BACKUP_KEEP_DAYS=14

# Optional: Fehler-Tracking
SENTRY_DSN=
